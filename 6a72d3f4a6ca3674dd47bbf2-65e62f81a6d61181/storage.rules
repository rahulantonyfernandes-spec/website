rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null
        && request.auth.token.email == 'admin@amarprinters.com';
    }

    match /site-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null
        && request.auth.token.email == 'admin@amarprinters.com';
    }
  }
}